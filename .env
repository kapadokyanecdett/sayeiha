# ============================================================
#  SAYE - E-posta (SMTP) ayarlari
#  Bu dosyayi ".env" adiyla kopyalayip kendi bilgilerinizi girin.
#  .env dosyasi yoksa sistem "test modu"nda calisir: dogrulama
#  kodu e-posta yerine sunucu konsoluna yazilir.
# ============================================================

# --- Gmail kullanimi ---
# 1) Google hesabinizda 2 Adimli Dogrulama'yi acin.
# 2) https://myaccount.google.com/apppasswords adresinden bir
#    "Uygulama sifresi" (16 haneli) olusturun.
# 3) Asagidaki SMTP_USER girisine Gmail adresinizi, SMTP_PASS
#    girisine olusan 16 haneli uygulama sifresini yazin.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sayeihatr@gmail.com
SMTP_PASS=nuqg siuw ypep eegl
SMTP_FROM=SAYE <ornek@gmail.com>

# Sitede gorunen marka adi (e-posta basliginda kullanilir)
SITE_NAME=SAYE
